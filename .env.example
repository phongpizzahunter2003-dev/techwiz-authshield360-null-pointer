# =============================================================================
# AuthShield 360 — environment template (BR-10: NEVER commit real secrets)
# Copy to `.env` and fill in values. `.env` is git-ignored.
# =============================================================================

# --- Database (MySQL profile) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=authshield360
DB_USER=root
DB_PASSWORD=change-me

# --- Token signing key (min 32 chars; generate with: openssl rand -base64 48) ---
AUTHSHIELD_SIGNING_KEY=change-me-to-a-long-random-value

# --- Simulated email (Mailtrap sandbox) — no real recipients (BR-01) ---
AUTHSHIELD_SMTP_HOST=sandbox.smtp.mailtrap.io
AUTHSHIELD_SMTP_PORT=2525
AUTHSHIELD_SMTP_USER=
AUTHSHIELD_SMTP_PASSWORD=

# --- CORS / frontend ---
AUTHSHIELD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://localhost:8080/api/v1
