# =============================================================================
# AuthShield 360 — environment template (BR-10: NEVER commit real secrets)
# Copy to `.env` and fill in values. `.env` is git-ignored.
# =============================================================================

# --- Database (mysql profile) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=authshield360
DB_USER=root
DB_PASSWORD=

# Hibernate dialect: leave UNCHANGED for a real MySQL 8 server.
# For MariaDB (e.g. the server bundled with XAMPP) use:
#   DB_DIALECT=org.hibernate.dialect.MariaDBDialect
DB_DIALECT=

# --- How the OTP is DELIVERED in this lab (nothing extra to install) ---
# The server always generates the OTP; this flag only decides WHERE it is visible:
#   true  = the code is returned in the API response (field `deliveryCode`) and therefore
#           shown in the UI / browser toast  -> convenient for demos
#   false = the code is NOT returned; it is only written to the backend log:
#             [SIMULATED-SMS]  to=0912...  subject='...' code=123456
#             [SIMULATED-EMAIL] to=...@mailtrap.io      code=123456
# It changes NOTHING else. There is no real SMS/e-mail sending in this project
# (BR-01 / VD-06: lab only, no real services).
AUTHSHIELD_EXPOSE_OTP=true

# --- Token signing key (min 32 chars; generate with: openssl rand -base64 48) ---
AUTHSHIELD_SIGNING_KEY=change-me-to-a-long-random-value

# --- SMTP settings for mode S3 (Email OTP) ---
# NOTE: these values are stored (encrypted) in the auth_config table and are editable in
# Admin > Auth configuration. The current MailGateway is a SIMULATED sender: it writes the
# OTP to the log instead of contacting a real SMTP server. Wiring a real mail relay
# (JavaMailSender -> Mailtrap) is an optional extension, not required for the lab.
# Never use real recipients (BR-01).
AUTHSHIELD_SMTP_HOST=sandbox.smtp.mailtrap.io
AUTHSHIELD_SMTP_PORT=2525
AUTHSHIELD_SMTP_USER=
AUTHSHIELD_SMTP_PASSWORD=

# --- CORS / frontend ---
AUTHSHIELD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://localhost:8080/api/v1
